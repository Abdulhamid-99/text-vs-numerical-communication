FROM python:3.11-slim-bookworm@sha256:a83ba18aef0f865b1a4a611c2cf460fe446f2795673bbb9fe43be570439e3b39

WORKDIR /study
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
COPY requirements-replay.txt .
RUN python -m pip install --no-cache-dir -r requirements-replay.txt

COPY verify.py .
COPY evidence/ evidence/
COPY state_transfer/ state_transfer/
COPY state_replay/ state_replay/
COPY retrieval/replay/ retrieval/replay/
COPY retrieval/secondary/ retrieval/secondary/
COPY retrieval/transfer/ retrieval/transfer/
COPY replay/ replay/
ENTRYPOINT ["python", "-B", "verify.py"]
